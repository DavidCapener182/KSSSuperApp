 test('actual Deployment response keeps Site Shift revision payload and requires two exact readbacks before success',async()=>{const row=offer(9,'SITE_SHIFT'),calls=[];let saved=false;const h=await deploymentHarness(async(url,options)=>{calls.push({url,options});if(options?.method==='PATCH'){saved=true;return json({revision:5});}return json({deployments:{items:[{...row,status:saved?'ACCEPTED':'ALLOCATED',revision:saved?5:4}],total:1}});});await h.mount();h.click('Accept allocation');await h.settle();const write=calls.find(c=>c.options?.method==='PATCH');assert.equal(write.url,`/api/deployments/site-shifts/me/${row.id}`);assert.deepEqual(JSON.parse(write.options.body),{response:'ACCEPTED',expectedRevision:4});assert.ok(calls.some(c=>c.url.includes(`allocationId=${row.id}&source=SITE_SHIFT`)));assert.match(text(h.render()),/Accepted allocation confirmed/);});
 test('actual Deployment decline keeps reason/note/source and mismatched readback never confirms',async()=>{const row=offer(10),writes=[];let saved=false;const h=await deploymentHarness(async(url,options)=>{if(options?.method==='PATCH'){writes.push({url,body:JSON.parse(options.body)});saved=true;return json({revision:5});}return json({deployments:{items:[{...row,source:saved?'SITE_SHIFT':'EVENT',status:saved?'DECLINED':'ALLOCATED',revision:saved?5:4}],total:1}});});await h.mount();h.click('Decline');h.setLabel('Reason','TIMING_CONFLICT');h.setLabel('Short note','Synthetic schedule conflict');h.click('Confirm decline');await h.settle();assert.deepEqual(writes,[{url:`/api/deployments/me/${row.id}`,body:{response:'DECLINED',expectedRevision:4,reasonCode:'TIMING_CONFLICT',note:'Synthetic schedule conflict'}}]);assert.doesNotMatch(text(h.render()),/Declined allocation confirmed/);assert.match(text(h.render()),/could not be confirmed/);});
 function contracts(source){const ast=ts.createSourceFile('source.tsx',source,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX),result={};function visit(n){if(ts.isFunctionDeclaration(n)&&n.name&&!['MyScheduleClient','MyDeploymentsClient','MyAttendanceClient'].includes(n.name.text))result['fn:'+n.name.text]=n.getText(ast);if(ts.isVariableDeclaration(n)&&ts.isIdentifier(n.name)&&n.initializer&&ts.isCallExpression(n.initializer)&&n.initializer.expression.getText(ast)==='useCallback')result['reader:'+n.name.text]=n.initializer.getText(ast);if(ts.isCallExpression(n)&&n.expression.getText(ast)==='useEffect')result['effect:'+Object.keys(result).filter(k=>k.startsWith('effect:')).length]=n.getText(ast);ts.forEachChild(n,visit);}visit(ast);return result;}
