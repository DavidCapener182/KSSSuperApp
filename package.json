{
  "name": "kss-super-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/check-deployment-env.mjs",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "smoke": "node --test tests/smoke.test.mjs",
    "test:regression": "KSS_TEST_AUTH_STATS=1 node --env-file=.env.local --env-file=.env.test.local --test --test-isolation=none --test-concurrency=1 tests/*.test.mjs",
    "test:access": "node --env-file=.env.local --env-file=.env.test.local --test tests/access.test.mjs",
    "test:sites": "node --env-file=.env.local --env-file=.env.test.local --test tests/site-journey.test.mjs",
    "test:shell": "node --env-file=.env.local --env-file=.env.test.local --test tests/shell.test.mjs",
    "test:documents": "node --env-file=.env.local --env-file=.env.test.local --test tests/documents.test.mjs",
    "test:document-review": "node --env-file=.env.local --env-file=.env.test.local --test tests/document-review.test.mjs",
    "test:work": "node --env-file=.env.local --env-file=.env.test.local --test tests/work.test.mjs",
    "test:onboarding": "node --env-file=.env.local --env-file=.env.test.local --test tests/onboarding.test.mjs",
    "test:profile-sia": "node --env-file=.env.local --env-file=.env.test.local --test tests/profile-sia.test.mjs",
    "test:controlled": "node --env-file=.env.local --env-file=.env.test.local --test tests/controlled-documents.test.mjs",
    "test:identity": "node --env-file=.env.local --env-file=.env.test.local --test tests/identity-evidence.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
