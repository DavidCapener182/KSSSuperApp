 test('actual Deployment decline keeps reason/note/source and mismatched readback never confirms',async()=>{const row=offer(10),writes=[];let saved=false;const h=await deploymentHarness(async(url,options)=>{if(options?.method==='PATCH'){writes.push({url,body:JSON.parse(options.body)});saved=true;return json({});}return json({deployments:{items:[{...row,source:saved?'SITE_SHIFT':'EVENT',status:saved?'DECLINED':'ALLOCATED'}],total:1}});});await h.mount();h.click('Decline');h.setLabel('Reason','TIMING_CONFLICT');h.setLabel('Short note','Synthetic schedule conflict');h.click('Confirm decline');await h.settle();assert.deepEqual(writes,[{url:`/api/deployments/me/${row.id}`,body:{response:'DECLINED',expectedRevision:4,reasonCode:'TIMING_CONFLICT',note:'Synthetic schedule conflict'}}]);assert.doesNotMatch(text(h.render()),/Declined allocation confirmed/);assert.match(text(h.render()),/could not be confirmed/);});
 function contracts(source){const ast=ts.createSourceFile('source.tsx',source,ts.ScriptTarget.Latest,true,ts.ScriptKind.TSX),result={};function visit(n){if(ts.isFunctionDeclaration(n)&&n.name&&!['MyScheduleClient','MyDeploymentsClient','MyAttendanceClient'].includes(n.name.text))result['fn:'+n.name.text]=n.getText(ast);if(ts.isVariableDeclaration(n)&&ts.isIdentifier(n.name)&&n.initializer&&ts.isCallExpression(n.initializer)&&n.initializer.expression.getText(ast)==='useCallback')result['reader:'+n.name.text]=n.initializer.getText(ast);if(ts.isCallExpression(n)&&n.expression.getText(ast)==='useEffect')result['effect:'+Object.keys(result).filter(k=>k.startsWith('effect:')).length]=n.getText(ast);ts.forEachChild(n,visit);}visit(ast);return result;}
 test('all existing readers/action/idempotency/lifetime functions, effects, route guards and shared CSS are unchanged',async()=>{for(const file of ['my-schedule-client.tsx','my-deployments-client.tsx','my-attendance-client.tsx'])assert.deepEqual(contracts(await readFile(folder+file,'utf8')),contracts(await readFile(baseline+folder+file,'utf8')),file);for(const file of ['src/app/(enterprise)/my-schedule/page.tsx','src/app/(enterprise)/my-deployments/page.tsx','src/app/(enterprise)/my-attendance/page.tsx',folder+'my-shift-entry.module.css',folder+'attendance.module.css'])assert.deepEqual(await readFile(file),await readFile(baseline+file),file);});
