+.tabs button { min-width: 120px; background: white; color: var(--kss-ink-soft); border-color: var(--kss-border); }
+.tabs button[aria-pressed="true"] { color: var(--kss-blue-strong); background: var(--kss-blue-soft); border-color: var(--kss-blue); }
+.page button[aria-pressed] { border-radius: 0; border: 0; border-bottom: 1px solid var(--kss-border); padding: 16px; }
+.page button[aria-pressed="true"] { background: var(--kss-blue-soft); }
+.page button[aria-pressed] strong { font-size: 16px; }
+.page button[aria-pressed] small { font-size: 14px; line-height: 1.5; }
+.page button[aria-pressed] > span:last-child { font-size: 12px; }
+.page [data-manager-calendar] { grid-template-columns: repeat(7,minmax(0,1fr)); gap: 0; border-left: 1px solid var(--kss-border); border-top: 1px solid var(--kss-border); }
+.page [data-manager-calendar] > div { min-height: 120px; border: 0; border-right: 1px solid var(--kss-border); border-bottom: 1px solid var(--kss-border); border-radius: 0; padding: 10px; }
+.page [data-manager-calendar] strong { font-size: 12px; }
